# Postgres connection string (Supabase). Use the *transaction pooler* URI
# (port 6543) — required for serverless on Vercel, fine for local dev too.
# Supabase dashboard -> Connect -> Transaction pooler.
DATABASE_URL=

# Where the app is served from (used in password-reset links and Stripe redirects).
# Local dev: http://localhost:5173. Production: your Vercel URL or custom domain.
APP_URL=http://localhost:5173

# API port in dev (Vite proxies /api here).
API_PORT=3001

# --- Email (Resend) — required in production for password resets ---
# Without it, reset emails print to the server console instead.
RESEND_API_KEY=
EMAIL_FROM="Chapter1 <no-reply@yourdomain.com>"

# --- Billing (Stripe) — leave unset to disable billing entirely ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
TRIAL_DAYS=14
